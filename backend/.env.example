# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL="mysql://root:password@localhost:3306/fajas_ab"

# Auth
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

# App metadata
APP_NAME="FAJAS AB API"
